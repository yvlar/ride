# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Copied from node_modules/maplibre-gl/dist by scripts/copy-maplibre-worker.mjs
/public/maplibre-gl-worker.mjs
/public/maplibre-gl-shared.mjs
/public/maplibre-gl-worker.js

# production
/build

# misc
.DS_Store
*.pem

# debug
.playwright-mcp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor iOS (FR-027) — commit the Xcode project, not Pods or build output
/ios/App/Pods
/ios/App/build
/ios/App/App/public
/ios/DerivedData
xcuserdata/
