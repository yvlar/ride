# Routing and geocoding are server-only.
# mock: deterministic grid graph (safe default). ai-rag: indexed local graph
# ranked by ChatGPT (requires OPENAI_API_KEY on the server); the displayed
# geometry uses the configured road-network adapter when one is set.
# For real roads, set osrm and point to a dedicated or managed OSRM service.
# Never use a public demonstration server for application traffic.
ROUTING_PROVIDER=mock
ROUTING_API_BASE_URL=
ROUTING_API_KEY=

# Server-only ChatGPT key for Corridors RAG (FR-029). Never use NEXT_PUBLIC_.
# OPENAI_API_BASE_URL defaults to https://api.openai.com/v1
# A Vercel AI Gateway key (vck_...) is routed to https://ai-gateway.vercel.sh/v1
# OPENAI_MODEL defaults to gpt-4o-mini (openai/gpt-4o-mini on the gateway)
# After setting the key on Vercel Preview/Production, redeploy.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=
OPENAI_MODEL=

# Server-only web search for Décrire mon trajet (FR-034). Never use NEXT_PUBLIC_.
# tavily (default when WEB_SEARCH_API_KEY is set), brave, or openai.
# If WEB_SEARCH_API_KEY is unset, OPENAI_API_KEY is used (Responses web_search
# or Vercel AI Gateway Exa when the key is vck_...).
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_API_BASE_URL=

# mock: deterministic local places (safe default for local and tests).
# nominatim: Nominatim-compatible HTTP API. Requires GEOCODING_API_BASE_URL.
# Never hardcode a public demonstration server.
GEOCODING_PROVIDER=mock
GEOCODING_API_BASE_URL=
GEOCODING_API_KEY=

# Weather and radar on the map (FR-043). Server-only, both keyless by default.
# open-meteo: public forecast API, no key required (default).
# mock: deterministic offline sky, for local work and tests.
# WEATHER_API_BASE_URL points a self-hosted or commercial Open-Meteo instance;
# leave blank for https://api.open-meteo.com/v1/
WEATHER_PROVIDER=open-meteo
WEATHER_API_BASE_URL=
WEATHER_API_KEY=

# rainviewer: public radar imagery index, no key required (default). Worldwide,
# with a short nowcast, but its public tiles stop at zoom 7 so the map has to
# stretch them at riding zoom.
# geomet: Meteorological Service of Canada WMS, no key required. A 1 km North
# American composite rendered at any extent, so it stays sharp; observations
# only (no nowcast) and transparent outside North America.
# mock: no imagery; the cloud markers still come from the forecast.
RADAR_PROVIDER=rainviewer
RADAR_API_BASE_URL=
RADAR_API_KEY=

# Base de référence des codes postaux et catalogue de trajets. Serveur uniquement.
# Never use NEXT_PUBLIC_ for these. See docs/postal-codes.md.
# Put an active publishable key (recommended) or legacy anon key in
# SUPABASE_ANON_KEY. RLS keeps it read-only. It is used by /api/geocode and
# /api/route-catalog. Leave both blank to disable these Supabase-backed reads.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Import pipelines only (npm run update:postal-codes and
# npm run import:route-catalog). Never expose this key to the browser and never
# set it on a client build.
SUPABASE_SERVICE_ROLE_KEY=

# Public map style URL is visible in the browser. Never put a secret here.
# Leave blank for the OSM raster fallback (FR-013, NFR-005).
# A vector style with a `building` source-layer enables 3D buildings during
# navigation follow (FR-024). Example without a secret:
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_STYLE_URL=

# Optional Next.js origin loaded by the iOS Capacitor shell (FR-027).
# Local live reload example: http://192.168.1.10:3000
# Leave unset to bundle public/index.html as a placeholder.
CAPACITOR_SERVER_URL=
