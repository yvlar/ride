# Routing and geocoding are server-only.
# mock: deterministic grid graph (safe default). ai-rag: indexed local graph
# ranked by ChatGPT (requires OPENAI_API_KEY on the server).
# For real roads, set osrm and point to a dedicated or managed OSRM service.
# Never use a public demonstration server for application traffic.
ROUTING_PROVIDER=mock
ROUTING_API_BASE_URL=
ROUTING_API_KEY=

# Server-only ChatGPT key for Corridors RAG (FR-029). Never use NEXT_PUBLIC_.
# OPENAI_API_BASE_URL defaults to https://api.openai.com/v1
# OPENAI_MODEL defaults to gpt-4o-mini
OPENAI_API_KEY=
OPENAI_API_BASE_URL=
OPENAI_MODEL=

# mock: deterministic local places (safe default for local and tests).
# nominatim: Nominatim-compatible HTTP API. Requires GEOCODING_API_BASE_URL.
# Never hardcode a public demonstration server.
GEOCODING_PROVIDER=mock
GEOCODING_API_BASE_URL=
GEOCODING_API_KEY=

# Public map style URL is visible in the browser. Never put a secret here.
# Leave blank for the OSM raster fallback (FR-013, NFR-005).
# A vector style with a `building` source-layer enables 3D buildings during
# navigation follow (FR-024). Example without a secret:
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_STYLE_URL=

# Optional Next.js origin loaded by the iOS Capacitor shell (FR-027).
# Local live reload example: http://192.168.1.10:3000
# Leave unset to bundle public/index.html as a placeholder.
CAPACITOR_SERVER_URL=
