# Routing and geocoding are server-only. Omit these values to use the mock.
# osrm: real roads from an OSRM server backed by OpenStreetMap data.
# The public endpoint below is for local evaluation, not production traffic.
# mock: deterministic grid graph. ai-rag: indexed version of that local graph.
ROUTING_PROVIDER=osrm
ROUTING_API_BASE_URL=https://router.project-osrm.org
ROUTING_API_KEY=
GEOCODING_API_BASE_URL=
GEOCODING_API_KEY=

# Public map style URL is visible in the browser. Never put a secret here.
# Leave blank to use the built-in OSM raster fallback (FR-013, NFR-005).
NEXT_PUBLIC_MAP_STYLE_URL=
