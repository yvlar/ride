{
  "version": 8,
  "name": "ride-kart-arcade-exploration",
  "glyphs": "__KA_GLYPHS_URL__",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "__KA_TILEJSON_URL__",
      "attribution": "__KA_ATTRIBUTION__"
    }
  },
  "layers": [
    {
      "id": "kart-background",
      "type": "background",
      "paint": { "background-color": "__KA_TERRAIN__" }
    },
    {
      "id": "kart-landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["match", ["get", "class"], ["residential", "suburb", "neighbourhood"], true, false],
      "paint": { "fill-color": "__KA_TERRAIN_LIGHT__", "fill-opacity": 0.72 }
    },
    {
      "id": "kart-landcover-farmland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["farmland", "grass", "meadow"], true, false],
      "paint": { "fill-color": "__KA_TERRAIN_LIGHT__", "fill-opacity": 0.82 }
    },
    {
      "id": "kart-park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["match", ["get", "class"], ["park", "cemetery", "recreation_ground"], true, false],
      "paint": { "fill-color": "#75C967", "fill-opacity": 0.9 }
    },
    {
      "id": "kart-forest",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["wood", "forest"], true, false],
      "paint": {
        "fill-color": ["interpolate", ["linear"], ["zoom"], 5, "__KA_FOREST__", 13, "__KA_FOREST_DARK__"],
        "fill-opacity": 0.86
      }
    },
    {
      "id": "kart-water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "__KA_WATER__", "fill-outline-color": "__KA_WATER_DEEP__" }
    },
    {
      "id": "kart-waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "__KA_WATER_DEEP__",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.8, 15, 3.2]
      }
    },
    {
      "id": "kart-building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": ["interpolate", ["linear"], ["zoom"], 13, "__KA_BUILDING_SECONDARY__", 17, "__KA_BUILDING__"],
        "fill-outline-color": "#C87346",
        "fill-opacity": 0.88
      }
    },
    {
      "id": "kart-tunnel-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "brunnel"], "tunnel"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "__KA_ROAD_CASING__",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 2, 17, 15],
        "line-opacity": 0.82
      }
    },
    {
      "id": "kart-tunnel",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "brunnel"], "tunnel"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "__KA_TUNNEL__",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 17, 10],
        "line-dasharray": [1.5, 1]
      }
    },
    {
      "id": "kart-road-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": ["all", ["match", ["get", "brunnel"], ["tunnel", "bridge"], false, true], ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"], true, false]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "__KA_ROAD_CASING__",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, ["match", ["get", "class"], ["motorway", "trunk"], 3, 1], 12, ["match", ["get", "class"], ["motorway", "trunk"], 9, ["primary", "secondary"], 7, 4], 18, ["match", ["get", "class"], ["motorway", "trunk"], 24, ["primary", "secondary"], 20, 12]]
      }
    },
    {
      "id": "kart-road-fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": ["all", ["match", ["get", "brunnel"], ["tunnel", "bridge"], false, true], ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"], true, false]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": ["match", ["get", "class"], ["motorway", "trunk"], "__KA_HIGHWAY__", ["primary", "secondary"], "__KA_MAIN_ROAD__", "__KA_LOCAL_ROAD__"],
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, ["match", ["get", "class"], ["motorway", "trunk"], 1.8, 0.5], 12, ["match", ["get", "class"], ["motorway", "trunk"], 6.5, ["primary", "secondary"], 5, 2.6], 18, ["match", ["get", "class"], ["motorway", "trunk"], 19, ["primary", "secondary"], 15, 8]]
      }
    },
    {
      "id": "kart-path-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "metadata": { "ride:decorative": true },
      "filter": ["match", ["get", "class"], ["path", "track"], true, false],
      "paint": {
        "line-color": "__KA_ROAD_CASING__",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1.3, 18, 7]
      }
    },
    {
      "id": "kart-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "metadata": { "ride:decorative": true },
      "filter": ["match", ["get", "class"], ["path", "track"], true, false],
      "paint": {
        "line-color": "#E6C98A",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.7, 18, 4],
        "line-dasharray": [2, 1.2]
      }
    },
    {
      "id": "kart-bridge-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "brunnel"], "bridge"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "__KA_ROAD_CASING__",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 3, 17, 16]
      }
    },
    {
      "id": "kart-bridge",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "brunnel"], "bridge"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": ["match", ["get", "class"], ["motorway", "trunk"], "__KA_HIGHWAY__", ["primary", "secondary"], "__KA_MAIN_ROAD__", "__KA_LOCAL_ROAD__"],
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 1.5, 17, 11]
      }
    },
    {
      "id": "kart-boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "maxzoom": 12,
      "paint": {
        "line-color": "__KA_SECONDARY_TEXT__",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.5, 10, 1.5],
        "line-opacity": 0.35,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "kart-water-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 5,
      "layout": {
        "text-field": ["coalesce", ["get", "name:fr"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 10, 15, 15]
      },
      "paint": {
        "text-color": "#0E6E91",
        "text-halo-color": "#DDF8FF",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "kart-road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 11,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:fr"], ["get", "name"], ["get", "ref"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 17, 15],
        "text-max-angle": 30,
        "symbol-spacing": 350
      },
      "paint": {
        "text-color": "__KA_PRIMARY_TEXT__",
        "text-halo-color": "__KA_ROAD_CASING__",
        "text-halo-width": 2
      }
    },
    {
      "id": "kart-poi-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 14,
      "metadata": { "ride:decorative": true },
      "filter": ["match", ["get", "class"], ["fuel", "park", "attraction", "viewpoint"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:fr"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-offset": [0, 1],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "__KA_SECONDARY_TEXT__",
        "text-halo-color": "#F7FFE9",
        "text-halo-width": 2
      }
    },
    {
      "id": "kart-place-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "layout": {
        "text-field": ["coalesce", ["get", "name:fr"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, ["match", ["get", "class"], "country", 15, 11], 8, ["match", ["get", "class"], ["city", "state"], 17, 13], 14, ["match", ["get", "class"], ["city", "town"], 20, 14]],
        "text-letter-spacing": 0.02,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "__KA_PRIMARY_TEXT__",
        "text-halo-color": "#F7FFE9",
        "text-halo-width": 2.2,
        "text-halo-blur": 0.4
      }
    }
  ]
}
